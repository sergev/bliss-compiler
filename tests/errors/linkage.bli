MODULE test =
BEGIN

! Linkages blissc cannot express on x86 (LRM 13.3).

LINKAGE
    regs = JSB (REGISTER = 0, STANDARD),
!! cerr %BLISS-E-LNKREGUNS,
    pj = PUSHJ;
!! cerr %BLISS-E-LNKTYPUNS,

! ACTUALCOUNT needs a CALL linkage (LRM 13.6.1.1)
ROUTINE r (a) : regs =
    BEGIN
    BUILTIN ACTUALCOUNT;
    ACTUALCOUNT ()
    END;
!! cerr %BLISS-E-LNKFNLNK,

! An INTERRUPT routine has one or two formals and cannot be called
LINKAGE
    intr = INTERRUPT;
ROUTINE i3 (a, b, c) : intr = 0;
!! cerr %BLISS-E-INTRPARMS,
ROUTINE i1 (frame) : intr = 0;
ROUTINE caller = i1 (0);
!! cerr %BLISS-E-INTRCALL,

END
ELUDOM
