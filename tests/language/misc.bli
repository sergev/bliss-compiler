MODULE test (IDENT = 'V1.0') =
BEGIN

! Features not covered elsewhere: embedded comments, SELECTA/U,
! address relations, DECRA, VOLATILE, PSECT, FORWARD/EXTERNAL data,
! EXTERNAL/GLOBAL LITERAL, GLOBAL BIND, general structure references,
! SWITCHES, REQUIRE, %REQUIRE, %QUOTENAME, CH$SIZE,
! CODECOMMENT, BUILTIN, QUAD, UNDECLARE, low-bit tests, WEAK.

LIBRARY 'testharness.lib';
REQUIRE 'misc.req';

SWITCHES NOOPTIMIZE, ERRS;

FORWARD
    fwd : VECTOR [3];

EXTERNAL
    test_extdata : VECTOR [3];

EXTERNAL LITERAL
    test_extlit;

GLOBAL LITERAL
    test_globlit = -77;

EXTERNAL ROUTINE
    test_globlit_value;

! WEAK (LRM 9.14): an unresolved weak EXTERNAL is 0; a strong
! definition (in testharness.c) overrides a weak GLOBAL.
EXTERNAL
    test_nodata : WEAK;
EXTERNAL ROUTINE
    test_nortn : WEAK,
    test_weaklit_value;
EXTERNAL LITERAL
    test_nolit : WEAK;
GLOBAL
    test_wkdata : WEAK INITIAL (5);
GLOBAL ROUTINE test_wkrtn : WEAK = 1;
GLOBAL LITERAL
    test_weaklit = 33 : WEAK;

PSECT
    OWN = mydata;

OWN
    v : VECTOR [4] INITIAL (1, 2, 3, 4),
    q : QUAD,
    vol : VOLATILE,
    fwd : VECTOR [3] INITIAL (7, 8, 9),
    buf : VECTOR [CH$ALLOCATION (16)];

GLOBAL BIND
    gbv = v[2];

LITERAL tmp = 5;
UNDECLARE tmp;

BUILTIN
    MOVSB;

test_setup(numcases=24);

GLOBAL ROUTINE runtest (caseno) : NOVALUE =
BEGIN
    LOCAL a, b, p;

    CASE .caseno FROM 1 TO 24 OF
    SET
        [1] : test_output(.caseno, 'comment=%ld', 1 %( + 100
                                                   + 200 )% + 2);
!! 1 comment=3
        [2] : BEGIN
            a = (SELECTA v[1] OF SET [v[0] TO v[2]] : 1; [OTHERWISE] : 2; TES);
            b = (SELECTONEA v[3] OF SET [v[0]] : 1; [v[2] TO v[3]] : 2; [OTHERWISE] : 3; TES);
            test_output(.caseno, 'selecta=%ld,%ld', .a, .b);
        END;
!! 2 selecta=1,2
        [3] : BEGIN
            a = (SELECTU -1 OF SET [0 TO 10] : 1; [OTHERWISE] : 2; TES);
            test_output(.caseno, 'selectu=%ld', .a);
        END;
!! 3 selectu=2
        [4] : test_output(.caseno, 'addrrel=%ld,%ld,%ld', v[1] NEQA v[2], v[1] LEQA v[1], v[0] GEQA v[3]);
!! 4 addrrel=1,1,0
        [5] : BEGIN
            a = 0;
            DECRA p FROM v[3] TO v[0] BY %UPVAL DO a = .a * 10 + ..p;
            test_output(.caseno, 'decra=%ld', .a);
        END;
!! 5 decra=4321
        [6] : BEGIN
            vol = 5;
            vol = .vol + 1;
            test_output(.caseno, 'volatile=%ld', .vol);
        END;
!! 6 volatile=6
        [7] : test_output(.caseno, 'forward=%ld,%ld', .fwd[0], .fwd[2]);
!! 7 forward=7,9
        [8] : test_output(.caseno, 'external=%ld,%ld', .test_extdata[1], .test_extdata[2]);
!! 8 external=20,30
        [9] : BEGIN
            gbv = 33;
            test_output(.caseno, 'globalbind=%ld', .v[2]);
            v[2] = 3;
        END;
!! 9 globalbind=33
        [10] : BEGIN
            p = v;
            test_output(.caseno, 'genstruct=%ld,%ld', .VECTOR [.p, 3], .BLOCK [.p, 1, 0, 8, 0]);
        END;
!! 10 genstruct=4,2
        [11] : test_output(.caseno, 'require=%ld,%ld', req_value, req_twice (4));
!! 11 require=17,8
        [12] : BEGIN
            ! %SWITCHES (LRM 15.5.11): SWITCHES last to the end of the block
            LOCAL a;
            BEGIN
                SWITCHES NOSAFE, ZIP;       ! no effect on the code in blissc
                a = %SWITCHES (NOSAFE, ZIP, NOOPTIMIZE);
            END;
            test_output(.caseno, 'switches=%ld,%ld,%ld,%ld', .a, %SWITCHES (SAFE, NOZIP),
                        %SWITCHES (OPTIMIZE), %SWITCHES (CODE, NODEBUG, ERRS, NOUNAMES));
        END;
!! 12 switches=1,1,0,1
        [13] : test_output(.caseno, 'quotename=%ld', %QUOTENAME ('REQ_', 'VALUE'));
!! 13 quotename=17
        [14] : test_output(.caseno, 'chsize=%ld', CH$SIZE (CH$PTR (buf)));
!! 14 chsize=8
        [15] : BEGIN
            CODECOMMENT 'just a comment' : BEGIN a = 9 END;
            test_output(.caseno, 'codecomment=%ld', .a);
        END;
!! 15 codecomment=9
        [16] : BEGIN
            p = MOVSB (3, CH$PTR (UPLIT ('abc')), CH$PTR (buf));
            CH$WCHAR (0, .p);
            test_output(.caseno, 'builtin=%s', buf);
        END;
!! 16 builtin=abc
        [17] : BEGIN
            q = -1;
            test_output(.caseno, 'quad=%ld,%ld', .q, %ALLOCATION (q));
        END;
!! 17 quad=-1,8
        [18] : test_output(.caseno, 'lowbit=%ld,%ld,%ld',
                (IF 2 THEN 1 ELSE 0), (IF 3 THEN 1 ELSE 0), (IF -1 THEN 1 ELSE 0));
!! 18 lowbit=0,1,1
        [19] : test_output(.caseno, 'undeclare=%ld', %DECLARED (tmp));
!! 19 undeclare=0
        [20] : test_output(.caseno, 'reqfunc=%ld', %REQUIRE ('miscexp.req') + 1);
!! 20 reqfunc=43
        [21] : BEGIN
            OWN init : VECTOR [2] INITIAL (test_extlit, test_extlit + 1);
            test_output(.caseno, 'extlit=%ld,%ld,%ld', test_extlit - 4, .init[0], .init[1]);
        END;
!! 21 extlit=1230,1234,1235
        [22] : test_output(.caseno, 'globlit=%ld,%ld', test_globlit, test_globlit_value ());
!! 22 globlit=-77,-77
        [23] : test_output(.caseno, 'weakext=%ld,%ld,%ld', test_nodata EQLA 0,
                           test_nortn EQLA 0, test_nolit);
!! 23 weakext=1,1,0
        [24] : test_output(.caseno, 'weakgbl=%ld,%ld,%ld', .test_wkdata, test_wkrtn (),
                           test_weaklit_value ());
!! 24 weakgbl=7,2,33
    TES;
END;

END
ELUDOM
