MODULE test =
BEGIN

! Floating point (BLISS-32 User Manual, chapter 4): there are no float
! operators; BUILTIN functions take the addresses of their operands.

LIBRARY 'testharness.lib';

BUILTIN
    ADDF, SUBF, MULF, DIVF, CMPF,
    ADDD, SUBD, MULD, DIVD, CMPD,
    ADDG, SUBG, MULG, DIVG, CMPG,
    CVTFD, CVTDF, CVTFL, CVTRFL, CVTDL, CVTRDL, CVTGL, CVTLF, CVTLD, CVTLG, CVTFG, CVTGF,
    ADDH, SUBH, MULH, DIVH, CMPH, CVTFH, CVTHF, CVTGH, CVTHG, CVTLH, CVTHL, CVTRHL;

OWN
    fa : LONG INITIAL (LONG (%E'1.5')),
    fb : LONG INITIAL (LONG (%E'4.0')),
    fc : LONG,
    da : INITIAL (%D'10.0'),
    db : INITIAL (%D'2.5'),
    dc,
    ga : INITIAL (%G'0.5'),
    gb : INITIAL (%G'-3.0'),
    gc,
    ld : LONG,
    lr : LONG,
    big : INITIAL (%D'1.0D40'),
    huge : INITIAL (%D'1.0D300'),
    neg : LONG INITIAL (LONG (%E'-2.5')),
    five : LONG INITIAL (LONG (-5)),
    ! H: IEEE quad, two fullwords (an octaword)
    ha : VECTOR [2] INITIAL (%H'1.5'),
    hb : VECTOR [2] INITIAL (%H'-2.0Q1'),
    hc : VECTOR [2],
    hbig : VECTOR [2] INITIAL (%H'1.0Q400');

test_setup(numcases=8);

GLOBAL ROUTINE runtest (caseno) : NOVALUE =
BEGIN
    LOCAL r1, r2, r3, r4;
    CASE .caseno FROM 1 TO 8 OF
    SET
        [1] : BEGIN
            ! SUBx (subtrahend, minuend, dst), DIVx (divisor, dividend, quot)
            ADDF (fa, fb, fc); r1 = .fc;
            SUBF (fa, fb, fc); r2 = .fc;
            MULF (fa, fb, fc); r3 = .fc;
            DIVF (fa, fb, fc); r4 = .fc;
            test_output(.caseno, 'F=%lx,%lx,%lx,%lx', .r1, .r2, .r3, .r4);
        END;
!! 1 F=40b00000,40200000,40c00000,402aaaab
        [2] : BEGIN
            ADDD (da, db, dc); r1 = .dc;
            SUBD (db, da, dc); r2 = .dc;
            MULG (ga, gb, gc); r3 = .gc;
            DIVG (ga, gb, gc); r4 = .gc;
            test_output(.caseno, 'D,G=%lx,%lx,%lx,%lx', .r1, .r2, .r3, .r4);
        END;
!! 2 D,G=4029000000000000,401e000000000000,bff8000000000000,c018000000000000
        [3] : test_output(.caseno, 'cmp=%ld,%ld,%ld,%ld,%ld', CMPF (fa, fb), CMPF (fb, fa),
                          CMPF (fa, fa), CMPD (da, db), CMPG (gb, ga));
!! 3 cmp=-1,1,0,1,-1
        [4] : BEGIN
            ! Float to longword: truncated, or rounded half away from zero
            CVTFL (neg, ld); r1 = .ld;
            CVTRFL (neg, lr); r2 = .lr;
            CVTRDL (db, lr); r3 = .lr;
            CVTGL (gb, ld); r4 = .ld;
            test_output(.caseno, 'tolong=%ld,%ld,%ld,%ld', .r1<0, 32, 1>, .r2<0, 32, 1>,
                        .r3<0, 32, 1>, .r4<0, 32, 1>);
        END;
!! 4 tolong=-2,-3,3,-3
        [5] : BEGIN
            ! Longword to float, and between F, D and G
            CVTLF (five, fc); r1 = .fc;
            CVTLD (five, dc); r2 = .dc;
            CVTFD (fa, dc); r3 = .dc;
            CVTDF (da, fc); r4 = .fc;
            test_output(.caseno, 'tofloat=%lx,%lx,%lx,%lx', .r1, .r2, .r3, .r4);
        END;
!! 5 tofloat=c0a00000,c014000000000000,3ff8000000000000,41200000
        [6] : BEGIN
            ! Overflow status: 1, or 0 if the value does not fit
            r1 = CVTDL (big, ld);
            r2 = .ld;
            r3 = CVTDF (huge, fc);
            r4 = CVTDF (da, fc);
            test_output(.caseno, 'overflow=%ld,%ld,%ld,%ld,%ld', .r1, .r2<0, 32, 1>, .r3, .r4,
                        CVTRFL (fa, lr));
        END;
!! 6 overflow=0,2147483647,0,1,1
        [7] : BEGIN
            ADDH (ha, hb, hc);              ! -18.5
            CVTRHL (hc, lr); r1 = .lr;
            DIVH (ha, hb, hc);              ! -20 / 1.5
            CVTHL (hc, ld); r2 = .ld;
            test_output(.caseno, 'H=%lx,%lx,%ld,%ld,%ld,%ld', .ha[1], .ha[0], .r1<0, 32, 1>,
                        .r2<0, 32, 1>, CMPH (ha, hb), CMPH (ha, ha));
        END;
!! 7 H=3fff800000000000,0,-19,-13,1,0
        [8] : BEGIN
            CVTLH (five, hc);
            CVTHF (hc, fc); r1 = .fc;
            CVTFH (fa, hc);
            CVTHG (hc, gc); r2 = .gc;
            r3 = CVTHG (hbig, gc);
            test_output(.caseno, 'Hcvt=%lx,%lx,%ld,%ld', .r1, .r2, .r3, CVTHG (hb, gc));
        END;
!! 8 Hcvt=c0a00000,3ff8000000000000,0,1
    TES;
END;

END
ELUDOM
