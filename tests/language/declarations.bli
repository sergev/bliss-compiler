MODULE test =
BEGIN

! Declarations: storage classes, INITIAL/PRESET, BIND, LITERAL,
! MAP, UNDECLARE, scoping, and PLITs.

LIBRARY 'testharness.lib';

LITERAL
    k1 = 10,
    k2 = k1 * 3 + 2,
    kneg = -5,
    kchar = %C'Z';

GLOBAL LITERAL
    gk = 77;

GLOBAL
    gvar : INITIAL (123),
    gvec : VECTOR [3] INITIAL (7, 8, 9);

OWN
    ovar : INITIAL (k2),
    otab : VECTOR [5] INITIAL (1, 2, REP 3 OF (6)),
    opre : VECTOR [6] PRESET ([0] = 11, [3] = 33, [5] = 55),
    obyt : VECTOR [4, BYTE] INITIAL (BYTE (1, 2, 3, 250)),
    owrd : VECTOR [2, WORD] INITIAL (WORD (1000, 60000)),
    oaddr : INITIAL (gvar),
    shadow : INITIAL (1),
    ocount,
    oal : ALIGN (4) INITIAL (5);

BIND
    bvar = gvar,
    btwo = gvec[1],
    bplit = PLIT (10, 20, 30) : VECTOR,
    ubplit = UPLIT (4, 5, 6) : VECTOR,
    bstr = UPLIT BYTE ('Hello', %CHAR (0)) : VECTOR [, BYTE],
    bascic = UPLIT (%ASCIC 'xyz') : VECTOR [, BYTE],
    bwords = UPLIT WORD (1, 2, 3) : VECTOR [, WORD],
    bnest = UPLIT (1, UPLIT (2, 3), 4) : VECTOR;

ROUTINE counter_next =
BEGIN
    OWN calls;          ! OWN inside a routine keeps its value
    calls = .calls + 1;
    .calls
END;

ROUTINE scoped (x) =
BEGIN
    LOCAL shadow;       ! hides the module-level OWN
    shadow = .x * 2;
    .shadow
END;

test_setup(numcases=27);

GLOBAL ROUTINE runtest (caseno) : NOVALUE =
BEGIN
    CASE .caseno FROM 1 TO 27 OF
    SET
        [1] : test_output(.caseno, 'literals=%ld,%ld,%ld,%c', k1, k2, kneg, kchar);
!! 1 literals=10,32,-5,Z
        [2] : test_output(.caseno, 'global=%ld,%ld,%ld', .gvar, .gvec[2], gk);
!! 2 global=123,9,77
        [3] : test_output(.caseno, 'own=%ld,%ld,%ld,%ld', .ovar, .otab[1], .otab[2], .otab[4]);
!! 3 own=32,2,6,6
        [4] : test_output(.caseno, 'preset=%ld,%ld,%ld,%ld', .opre[0], .opre[1], .opre[3], .opre[5]);
!! 4 preset=11,0,33,55
        [5] : test_output(.caseno, 'bytes=%ld,%ld,%ld', .obyt[0], .obyt[3], .owrd[1]);
!! 5 bytes=1,250,60000
        [6] : test_output(.caseno, 'addr=%ld', ..oaddr);
!! 6 addr=123
        [7] : BEGIN
            bvar = 456;
            test_output(.caseno, 'bind=%ld,%ld,%ld', .gvar, .bvar, .btwo);
            gvar = 123;
        END;
!! 7 bind=456,456,8
        [8] : test_output(.caseno, 'plit=%ld,%ld,%ld', .bplit[0], .bplit[2], .bplit[-1]);
!! 8 plit=10,30,3
        [9] : test_output(.caseno, 'uplit=%ld,%ld', .ubplit[0], .ubplit[2]);
!! 9 uplit=4,6
        [10] : test_output(.caseno, 'strplit=%s,%c', bstr, .bstr[1]);
!! 10 strplit=Hello,e
        [11] : test_output(.caseno, 'ascic=%ld,%c', .bascic[0], .bascic[3]);
!! 11 ascic=3,z
        [12] : test_output(.caseno, 'wordplit=%ld,%ld', .bwords[1], .bwords[2]);
!! 12 wordplit=2,3
        [13] : test_output(.caseno, 'nested=%ld,%ld,%ld', .bnest[0], .(.bnest[1] + %UPVAL), .bnest[2]);
!! 13 nested=1,3,4
        [14] : test_output(.caseno, 'ownrtn=%ld,%ld,%ld', counter_next(), counter_next(), counter_next());
!! 14 ownrtn=1,2,3
        [15] : test_output(.caseno, 'scope=%ld,%ld', scoped(21), .shadow);
!! 15 scope=42,1
        [16] : BEGIN
            LOCAL a, b : VECTOR [3], c;
            a = 1;
            b[0] = 2; b[2] = 4;
            c = .a + .b[0] + .b[2];
            test_output(.caseno, 'local=%ld', .c);
        END;
!! 16 local=7
        [17] : BEGIN
            STACKLOCAL s : VECTOR [2];
            REGISTER r;
            s[0] = 3; s[1] = 4;
            r = .s[0] * .s[1];
            test_output(.caseno, 'stack=%ld', .r);
        END;
!! 17 stack=12
        [18] : BEGIN
            LOCAL p;
            MAP p : REF VECTOR;
            p = gvec;
            test_output(.caseno, 'map=%ld', .p[1]);
        END;
!! 18 map=8
        [19] : BEGIN
            LITERAL k1 = 99;        ! inner declaration hides the outer one
            test_output(.caseno, 'innerlit=%ld', k1);
        END;
!! 19 innerlit=99
        [20] : test_output(.caseno, 'align=%ld,%ld', .oal, (oal AND 15) EQL 0);
!! 20 align=5,1
        [21] : BEGIN
            LOCAL x : INITIAL (17);
            test_output(.caseno, 'localinit=%ld', .x);
        END;
!! 21 localinit=17
        [22] : BEGIN
            LOCAL lv : VECTOR [4] INITIAL (5, 6, 7, 8);
            test_output(.caseno, 'localvec=%ld,%ld', .lv[0], .lv[3]);
        END;
!! 22 localvec=5,8
        [23] : BEGIN
            LOCAL lp : VECTOR [4] PRESET ([1] = 21, [3] = 43);
            test_output(.caseno, 'localpreset=%ld,%ld,%ld', .lp[0], .lp[1], .lp[3]);
        END;
!! 23 localpreset=0,21,43
        [24] : BEGIN
            LOCAL q;
            q = 5;
            BEGIN
                LOCAL p : INITIAL (.q + 1);     ! evaluated at block entry
                test_output(.caseno, 'blockinit=%ld', .p);
            END;
        END;
!! 24 blockinit=6
        [25] : BEGIN
            LOCAL a : INITIAL (3), b : INITIAL (.a * 10);
            test_output(.caseno, 'initorder=%ld', .b);
        END;
!! 25 initorder=30
        [26] : BEGIN
            LOCAL idx;
            idx = 2;
            BEGIN
                BIND elem = gvec[.idx];        ! bound at block entry
                test_output(.caseno, 'blockbind=%ld', .elem);
            END;
        END;
!! 26 blockbind=9
        [27] : BEGIN
            LOCAL fp;
            fp = counter_next;
            BEGIN
                BIND ROUTINE f = .fp;
                test_output(.caseno, 'blockbindrtn=%ld', f() GTR 0);
            END;
        END;
!! 27 blockbindrtn=1
    TES;
END;

END
ELUDOM
