MODULE test =
BEGIN

LIBRARY 'testharness.lib';

LITERAL
    a = 65535,
    b = -1,
    c = %DECIMAL'-10',
    d = %O'177',   ! 127 decimal
    e = %B'1101',  ! 13 decimal
    f = %X'7F',
    g = %C'''';

BIND
    h = UPLIT('untyped string literal', %CHAR(0)),
    i = UPLIT(%ASCII'%ASCII string literal', %CHAR(0)),
    j = UPLIT(%ASCIC'counted string literal') : VECTOR [,BYTE],
    k = UPLIT(%ASCIZ'null-terminated string literal'),
    ! %ASCID: the address of a descriptor (LRM 4.3.4)
    l = %ASCID'described string' : BLOCK [2];

EXTERNAL ROUTINE
    test_dsc_check;

! Floating-point literals (LRM 4.2): IEEE bit patterns
OWN
    fv : VECTOR [2, LONG] INITIAL (LONG (%E'1.5', %E'-2.5E1'));
    
test_setup(numcases=15);

GLOBAL ROUTINE runtest (caseno) : NOVALUE =
BEGIN
    CASE .caseno FROM 1 TO 15 OF
    SET
        [1] : test_output(.caseno, 'a = [%d,0x%x]', a, a);
!! 1 a = [65535,0xffff]
        [2] : test_output(.caseno, 'b = [%d,0x%x]', b, b);
!! 2 b = [-1,0xffffffff]
        [3] : test_output(.caseno, 'c = [%d,0x%x]', c, c);
!! 3 c = [-10,0xfffffff6]
        [4] : test_output(.caseno, 'd = [%d,0x%x]', d, d);
!! 4 d = [127,0x7f]
        [5] : test_output(.caseno, 'e = [%d,0x%x]', e, e);
!! 5 e = [13,0xd]
        [6] : test_output(.caseno, 'f = [%d,0x%x]', f, f);
!! 6 f = [127,0x7f]
        [7] : test_output(.caseno, 'g = ["%c",0x%x]', g, g);
!! 7 g = ["'",0x27]
        [8] : test_output(.caseno, 'h = "%s"', h);
!! 8 h = "untyped string literal"
        [9] : test_output(.caseno, 'i = "%s"', i);
!! 9 i = "%ASCII string literal"
       [10] : test_output(.caseno, 'j = "%-*.*s" (length=%d)',
                          .j[0], .j[0], j[1], .j[0]);
!!10 j = "counted string literal" (length=22)
       [11] : test_output(.caseno, 'k = "%s"', k);
!!11 k = "null-terminated string literal"
       [12] : test_output(.caseno, 'l = "%.*s" (length=%d,type=%d,class=%d)',
                          .l[0, 0, 16, 0], .l[1, 0, %BPVAL, 0],
                          .l[0, 0, 16, 0], .l[0, 16, 8, 0], .l[0, 24, 8, 0]);
!!12 l = "described string" (length=16,type=14,class=1)
       [13] : test_output(.caseno, 'ascid from C = %ld', test_dsc_check (%ASCID 'from C'));
!!13 ascid from C = 6
       [14] : test_output(.caseno, 'float = %lx,%lx,%lx,%lx', %E'1.5', %E'-2.5E1', %D'1.5', %G'1.0G-2');
!!14 float = 3fc00000,c1c80000,3ff8000000000000,3f847ae147ae147b
       [15] : test_output(.caseno, 'float initial = %lx,%lx', .fv[0], .fv[1]);
!!15 float initial = 3fc00000,c1c80000
    TES;
END;

END
ELUDOM
